# Environment Configuration for Jarvis APIs
# Copy this to .env and fill in your API keys

# Finnhub Stock Data API
# Get free key: https://finnhub.io
FINNHUB_API_KEY=your_finnhub_api_key_here

# SEC EDGAR API (Free, no key required)
# Data source: https://data.sec.gov/submissions/
SEC_EDGAR_BASE_URL=https://data.sec.gov/submissions

# OpenCorporates API (Optional, for company governance)
# Get free key: https://opencorporates.com/api
OPENCORPORATES_API_KEY=your_opencorporates_api_key_here

# Flask/FastAPI Environment
ENVIRONMENT=development
DEBUG=True

# Dev Mode - Set to false for production (analyzes all tickers instead of 5)
DEV_MODE=True
DEV_TICKERS_LIMIT=5

# CORS Configuration (comma-separated list of allowed origins)
# Default: http://localhost:3000,http://localhost:8000
# Production: https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
