# Stock Analysis Application Configuration
# Copy this file to .env and fill in your actual values
# DO NOT COMMIT .env TO GIT (it's in .gitignore)

# API Keys & Credentials
FINNHUB_API_KEY=your_finnhub_api_key_here
SECRET_KEY=your_secret_key_here_generate_with_openssl_rand_32

# Database (Future)
DATABASE_URL=postgresql://user:password@localhost/stock_analysis

# Security
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# API Rate Limiting (requests per hour)
RATE_LIMIT_REFRESH=1
RATE_LIMIT_ANALYSIS=30
RATE_LIMIT_DEFAULT=100

# JWT (Phase 5)
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Monitoring & Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# External Services
SEC_EDGAR_BASE_URL=https://www.sec.gov/cgi-bin/browse-edgar?action=getcompany
FINNHUB_BASE_URL=https://finnhub.io/api/v1

# Email (Phase 5)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here

# Stripe (Phase 6)
STRIPE_PUBLIC_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_key_here

# AI Assistant (Phase 5)
OPENAI_API_KEY=sk_your_openai_key_here
GPT_MODEL=gpt-4
AI_ASSISTANT_ENABLED=False

# File Upload
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=input/filings

# Video Integration (Phase 5)
YOUTUBE_API_KEY=your_youtube_api_key_here
VIDEO_ENABLED=False
